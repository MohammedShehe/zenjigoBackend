NODE_ENV=production   # use 'development' only on a developer machine
PORT=5000
APP_NAME=ZenjiGO
API_PREFIX=/api/v1

# MySQL. In docker-compose, DB_HOST is forced to the service name 'mysql' (never localhost).
# For a non-Docker local run use DB_HOST=localhost.
DB_HOST=localhost
DB_ROOT_PASSWORD=CHANGE_ME_DB_PASSWORD   # used by docker-compose (MySQL root + API DB_PASSWORD)
DB_PORT=3306
DB_NAME=zenjigo
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=20

# JWT - CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES=15m   # keep short; clients silently refresh (the old live .env used 90d)
JWT_REFRESH_EXPIRES=30d

# CORS - comma separated origins. In production use your exact app/web origins.
# Production example: CORS_ORIGINS=https://zenjigo.online,https://www.zenjigo.online,https://api.zenjigo.online
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:5501,http://127.0.0.1:5501,http://localhost:5502,http://127.0.0.1:5502,http://localhost:5503,http://127.0.0.1:5503

# OTP is delivered by email only. Configure SMTP below.



# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=zenjigo

# Firebase Admin / FCM
# Prefer a JSON file path outside git OR put the JSON object in FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Alternative: absolute path to service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json   # mounted by docker-compose from ./secrets/

# Security / limits
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Ride / currency defaults for Zanzibar
CURRENCY=TZS
DEFAULT_COUNTRY_CODE=+255
DEFAULT_RIDE_TIMEOUT_SECONDS=45
DRIVER_LOCATION_STALE_SECONDS=60
BASE_FARE_TZS=2500
PER_KM_FARE_TZS=900
PER_MINUTE_FARE_TZS=150
BOOKING_FEE_TZS=500
DRIVER_COMMISSION_PERCENT=20

# Optional email settings for admin/system emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="ZenjiGO <no-reply@example.com>"

# Seed admin (change immediately)
SEED_ADMIN_EMAIL=admin@zenjigo.example
SEED_ADMIN_PASSWORD=ChangeMe_StrongPassword_123!

# ===== SNIPPE PAYMENT GATEWAY =====
# Docs: https://docs.snippe.sh/
# Get API key: Snippe Dashboard → Settings → API Keys
SNIPPE_API_KEY=CHANGE_ME_SNIPPE_API_KEY
SNIPPE_BASE_URL=https://api.snippe.sh
# Public HTTPS webhook URL (must match what you register in Snippe dashboard)
SNIPPE_WEBHOOK_URL=https://api.zenjigo.online/api/v1/payments/webhook
SNIPPE_CALLBACK_URL=https://api.zenjigo.online/api/v1/payments/webhook
# Webhook signing secret from Snippe Dashboard → Settings → Webhook Secret
SNIPPE_WEBHOOK_SECRET=CHANGE_ME_SNIPPE_WEBHOOK_SECRET

PAYMENT_PROVIDER=snippe
# Local development only: accept unsigned webhooks (ignored when NODE_ENV=production)
ALLOW_UNSIGNED_WEBHOOKS=false
# Driver settlement business rules
DRIVER_SETTLEMENT_THRESHOLD_TZS=60000
DRIVER_COMMISSION_PERCENT=20
DRIVER_AUTOPAY_PROVIDER=snippe
# Rider cancellation charge
CANCEL_NEAR_PICKUP_KM=1
CANCEL_NEAR_PICKUP_PERCENT=20


# Admin seed phone is an account contact field; OTP is delivered to the admin email.
SEED_ADMIN_PHONE=+255700000001

# Local-only OTP console fallback. Never enable in production.
OTP_ALLOW_CONSOLE=false
# Dev-only, ignored in production: fixed OTP for local testing (code is never logged)
# OTP_DEV_FIXED_CODE=123456
OTP_MAX_PER_HOUR=8
AUTH_RATE_LIMIT_MAX=30
SOCKET_LOCATION_MIN_INTERVAL_MS=1000

# Google Maps / Distance Matrix (optional but recommended for accurate road km + duration)
# Enable Distance Matrix API + Geocoding in Google Cloud Console.
# When set, ride quotes use real road distance instead of straight-line Haversine.
GOOGLE_MAPS_API_KEY=
# Optional: separate key for the admin console map (Maps JavaScript API), restricted to your admin site HTTP referrer.
# Falls back to GOOGLE_MAPS_API_KEY when empty.
GOOGLE_MAPS_BROWSER_KEY=AIzaSyD2_9WpUt3D0SlOJTMKY5kK_omBZ0tUhC4

# ===== Scaling / dispatch =====
RATE_LIMIT_MAX=3000
DISPATCH_RADIUS_KM=8
RIDE_SEARCH_WINDOW_SECONDS=180
LOCATION_HISTORY_INTERVAL_MS=10000
DB_CONNECTION_LIMIT=30

# ---- Ride lifecycle (all optional; defaults shown) ----
RIDE_DRIVER_STALE_MINUTES=10        # assigned driver silent this long => ride re-dispatched / rider may end a started trip
RIDE_ACCEPTED_MAX_MINUTES=45        # accepted but driver never arrived => re-dispatch
RIDE_NOSHOW_MINUTES=15              # driver waiting at pickup => no-show handling
RIDE_TRIP_STALE_MINUTES=30          # started trip with silent driver => auto-closed + flagged for admin
RIDE_TRIP_MAX_HOURS=6               # hard cap on a running trip
RIDE_CASH_AUTOCONFIRM_MINUTES=30    # destination reached, cash, driver never confirmed => auto-complete
RIDE_PAYMENT_OVERDUE_MINUTES=60     # destination reached, unpaid => flag for admin
RIDE_PAYMENT_TTL_MINUTES=4          # mobile-money prompt lifetime before the rider may retry
RIDE_MAX_REDISPATCH=2               # times a ride may be handed to a new driver before it is cancelled
RIDE_MAX_DISTANCE_KM=150            # longest single trip accepted
