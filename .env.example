NODE_ENV=development
PORT=5000
APP_NAME=ZenjiGO
API_PREFIX=/api/v1

# MySQL - your requested local defaults
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenjigo
DB_USER=root
DB_PASSWORD=
DB_CONNECTION_LIMIT=20

# JWT - CHANGE THESE IN PRODUCTION
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# CORS - comma separated origins. In production use your exact app/web origins.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5501,http://127.0.0.1:5501

# Twilio Verify (recommended: use Verify Service SID)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_OTP_CHANNEL=sms

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=zenjigo

# Firebase Admin / FCM
# Prefer a JSON file path outside git OR put the JSON object in FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# Alternative: absolute path to service-account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Security / limits
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
MAX_UPLOAD_MB=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Ride / currency defaults for Zanzibar
CURRENCY=TZS
DEFAULT_COUNTRY_CODE=+255
DEFAULT_RIDE_TIMEOUT_SECONDS=45
DRIVER_LOCATION_STALE_SECONDS=60
BASE_FARE_TZS=2500
PER_KM_FARE_TZS=900
PER_MINUTE_FARE_TZS=150
BOOKING_FEE_TZS=500
DRIVER_COMMISSION_PERCENT=20

# Optional email settings for admin/system emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=example@example.com
SMTP_PASSWORD=change_me
SMTP_FROM="ZenjiGO <no-reply@example.com>"

# Seed admin (change immediately)
SEED_ADMIN_EMAIL=admin@zenjigo.example
SEED_ADMIN_PASSWORD=ChangeMe_StrongPassword_123!

# Payment provider (replace with your Tanzanian PSP/mobile-money provider)
PAYMENT_PROVIDER=example
PAYMENT_API_BASE_URL=https://api.example-payment.com
PAYMENT_API_KEY=CHANGE_ME
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_PAYMENT_WEBHOOK_SECRET
# Driver settlement business rules
DRIVER_SETTLEMENT_THRESHOLD_TZS=60000
DRIVER_COMMISSION_PERCENT=20
DRIVER_AUTOPAY_PROVIDER=example
# Rider cancellation charge
CANCEL_NEAR_PICKUP_KM=1
CANCEL_NEAR_PICKUP_PERCENT=20

# Admin seed phone used for Twilio OTP. Replace with your real E.164 number.
SEED_ADMIN_PHONE=+255700000001
